# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM gingersociety/rust-rocket-api-builder:latest as builder

WORKDIR /build
ARG GINGER_TOKEN

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN ginger-auth token-login $GINGER_TOKEN
RUN ginger-connector connect prod

ENV OPENSSL_STATIC=1
RUN cargo build --release --bin ginger-infra

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin runner

COPY --from=builder /build/target/release/ginger-infra /usr/local/bin/ginger-infra

USER 10001

ENTRYPOINT ["/usr/local/bin/ginger-infra", "rpc"]