FROM gingersociety/rust-rocket-api-builder:latest AS builder

WORKDIR /build
ARG GINGER_TOKEN

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN ginger-auth token-login $GINGER_TOKEN
RUN ginger-connector connect prod

ENV OPENSSL_STATIC=1
ENV OPENSSL_LIB_DIR=/usr/lib/x86_64-linux-gnu
ENV OPENSSL_INCLUDE_DIR=/usr/include/openssl
RUN cat GingerBucket_client/Cargo.toml IAMService_client/Cargo.toml MetadataService_client/Cargo.toml GingerPresence_client/Cargo.toml | grep -A2 reqwest

RUN cargo build --release --bin ginger-infra

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin runner

COPY --from=builder /build/target/release/ginger-infra /usr/local/bin/ginger-infra
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER 10001
ENTRYPOINT ["/entrypoint.sh"]