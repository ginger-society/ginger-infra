# Dockerfile.runner
#
# Builds the external-executor-runner image.
# This is the image that Tekton TaskRun steps actually run.
# It contains ginger-infra (for the `rpc` subcommand) and entrypoint.sh,
# which writes REMOTE_SCRIPT / REMOTE_CLEANUP from env to /tmp and then
# calls: ginger-infra rpc --envrc /dev/null --script /tmp/script.sh …
#
# The script, cleanup script, and all env vars are injected by the controller
# directly into the TaskRun step spec — no ConfigMap or Secret mounts needed.

# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM gingersociety/rust-rocket-api-builder:latest AS builder

WORKDIR /build
ARG GINGER_TOKEN

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN ginger-auth token-login $GINGER_TOKEN
RUN ginger-connector connect prod

ENV OPENSSL_STATIC=1
RUN cargo build --release --bin ginger-infra

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin runner

COPY --from=builder /build/target/release/ginger-infra /usr/local/bin/ginger-infra
COPY entrypoint.sh /entrypoint.sh

USER 10001

ENTRYPOINT ["/entrypoint.sh"]