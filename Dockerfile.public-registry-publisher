# Dockerfile.public-registry-publisher
#
# Builds the public-registry-publisher binary.
# The controller's only job is: watch RemoteTask → create TaskRun.
# It does no HTTP work and holds no executor connection.

# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM gingersociety/rust-rocket-api-builder:latest AS builder

WORKDIR /build
ARG GINGER_TOKEN

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN ginger-auth token-login $GINGER_TOKEN
RUN ginger-connector connect prod

ENV OPENSSL_STATIC=1
RUN cargo build --release --bin public-registry-publisher

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin controller

COPY --from=builder /build/target/release/public-registry-publisher \
    /usr/local/bin/public-registry-publisher

USER 10001

ENTRYPOINT ["/usr/local/bin/public-registry-publisher"]